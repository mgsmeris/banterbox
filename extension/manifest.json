{
  "manifest_version": 3,
  "name": "BanterBox",
  "version": "1.3.0",
  "description": "Fixes the Siropu Chat shoutbox on perpheads.com and adds a custom emoji menu.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BanterBox",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://perpheads.com/*",
        "https://www.perpheads.com/*"
      ],
      "js": [
        "settings-core.js",
        "storage-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://perpheads.com/*",
        "https://www.perpheads.com/*"
      ],
      "js": [
        "banterbox.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "banterbox@smeris.me",
      "strict_min_version": "128.0"
    }
  }
}
