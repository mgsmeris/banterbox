# BanterBox emoji server, public/ directory (served at /sb).
# Needs AllowOverride FileInfo Options Indexes (or All) and mod_rewrite.

Options -Indexes -MultiViews
DirectoryIndex index.php

# Only these PHP files exist here, and only they may run. Anything else ending
# in .php (which should never exist) is refused.
<FilesMatch "\.(php|phtml|phar|php\d|pht|phps)$">
	Require all denied
</FilesMatch>
<FilesMatch "^(index|e|emojis|privacy)\.php$">
	Require all granted
</FilesMatch>

# Never serve dotfiles or backups.
<FilesMatch "(^\.|~$|\.(bak|orig|swp|sqlite|log|ini|sh)$)">
	Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^emojis\.json$ emojis.php [L]
	RewriteRule ^privacy$ privacy.php [L]
	RewriteRule ^e/([a-f0-9]{32})\.(png|gif|webp)$ e.php?id=$1&ext=$2 [L]
</IfModule>

# Firefox add-on update manifest (update_url in the extension). Written by CI.
AddType application/json .json

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	<FilesMatch "\.(css|js|png)$">
		Header set Cache-Control "public, max-age=604800"
	</FilesMatch>
	<Files "update.json">
		Header set Cache-Control "no-cache"
		# The extension's update checker reads it from the add-on's own origin.
		Header set Access-Control-Allow-Origin "*"
	</Files>
</IfModule>
